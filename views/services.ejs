<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Batman | Services</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-black text-gray-200">

<header class="border-b border-gray-800">
  <nav class="max-w-7xl mx-auto flex justify-between items-center px-8 py-4">
    
    <a class="text-xl font-semibold text-blue-500 tracking-wide" href="/afterlogin">
    ⬅️  Back To Home
    </a>
  </nav>
</header>

<main class="max-w-7xl mx-auto px-8 py-24">
  <h2 class="text-3xl font-semibold text-white mb-4">
    Services
  </h2>

  <h3 class="mb-4">Explore our curated Batman collection featuring the most iconic novels, comics, and cinematic releases. Add your favorites to the cart and build your ultimate Batman experience.</h3>
    <div class="lg:col-span-2 space-y-6">

        <% if(items.length === 0) { %>
          <p class="text-zinc-400">Services are not added yet.</p>
        <% } %>

        <% items.forEach(card => { %>
          <div class="flex bg-zinc-800 rounded-lg overflow-hidden shadow-md">

            <!-- IMAGE -->
            <img 
              src="<%= card.image %>" 
              alt=""
              class="w-40 h-40 object-cover"
            />

            <!-- DETAILS -->
            <div class="flex-1 p-5 flex flex-col justify-between">
              <div>
                <h3 class="text-xl font-medium mb-2">
                  <%= card.title %>
                </h3>
                <p class="text-zinc-400 text-sm">
                  <%= card.desc %>
                </p>
              </div>
               
              <div class="flex items-center justify-between mt-4">
                <span class="text-lg font-semibold text-blue-400">
                  ₹ <%= card.price + 20 - card.discount %>
                </span>


                <a 
                  href="/cart/add/<%= card._id %>" 
                  class="bg-yellow-600 hover:bg-blue-700 transition px-4 py-2 rounded text-sm"
                >
                  Add To Cart
                </a>
              </div>
            </div>

          </div>
        <% }) %>

      </div>

</main>

</body>
</html>
