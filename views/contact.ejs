<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Batman | Contact</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-black text-gray-200">

<header class="border-b border-gray-800">
  <nav class="max-w-7xl mx-auto flex justify-between items-center px-8 py-4">
     <a class="text-xl font-semibold text-blue-500 tracking-wide" href="/afterlogin">
    ⬅️  Back To Home
    </a>
  </nav>
</header>

<main class="max-w-4xl mx-auto px-8 py-24">
  <h2 class="text-3xl font-semibold text-white mb-4">
    Contact
  </h2>
  <p class="text-gray-400 mb-10">
    Reach out for business inquiries or collaborations.
  </p>

  <form class="grid gap-6 max-w-xl">
    <input
      class="bg-black border border-gray-800 p-3 focus:border-blue-500 outline-none"
      placeholder="Full Name"
    />
    <input
      class="bg-black border border-gray-800 p-3 focus:border-blue-500 outline-none"
      placeholder="Email Address"
    />
    <textarea
      rows="4"
      class="bg-black border border-gray-800 p-3 focus:border-blue-500 outline-none resize-none"
      placeholder="Message"
    ></textarea>

    <button
      class="self-start border border-blue-500 text-blue-500 px-6 py-3 text-sm uppercase hover:bg-blue-500 hover:text-black transition"
    >
      Submit
    </button>
  </form>
</main>

</body>
</html>
