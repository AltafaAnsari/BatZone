<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Batman | Home</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-black text-gray-200">

<!-- Header -->
<header class="border-b border-gray-800">
  <nav class="max-w-7xl mx-auto flex items-center justify-between px-8 py-4">
    <a class="text-xl font-semibold text-blue-500 tracking-wide" href="/afterlogin">
    ⬅️  Back To Home
    </a>
       
  </nav>
</header>

    <div class="p-10">
       <h3 class="text-3xl mb-3"><span class="font-light">Hello</span>! <%= user.username %>👋</h3>
       <h3>Now, you can access all our services.</h3>
       </div>


<!-- Hero -->
<main class="max-w-7xl mx-auto px-8 py-15">
  <div class="max-w-3xl">
    <h2 class="text-5xl font-semibold text-white leading-tight mb-6">
