<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Product Details</title>
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body class="bg-black text-gray-200">

<!-- Header -->
<header class="border-b border-gray-800">
  <div class="max-w-7xl mx-auto px-8 py-4 flex justify-between items-center">
    <h1 class="text-lg font-semibold text-blue-500">BATMAN</h1>
    <a href="/cart" class="text-sm hover:text-blue-400">View Cart</a>
  </div>
</header>

<!-- Products Section -->
<main class="max-w-7xl mx-auto px-8 py-20">

  <h2 class="text-3xl font-semibold text-white mb-10">
    Product Details
  </h2>

  <div class="grid md:grid-cols-3 gap-8">


      <div class="border border-gray-800 p-6 flex flex-col">

        <!-- Image -->
        <img
          src="<%= product.image %>"
          alt=""
          class="h-48 object-cover mb-4"
        />

        <!-- Title -->
        <h3 class="text-lg font-medium text-white mb-2">
          <%= product.title %>
        </h3>

        <!-- Description -->
        <p class="text-sm text-gray-400 mb-4">
          <%= product.desc %>
        </p>

        <!-- Pricing -->
        <div class="text-sm text-gray-300 space-y-1 mb-6">
          <p>Price: ₹ <%= product.price %></p>
          <p>Discount: <span class="text-green-400">₹ <%= product.discount %></span></p>
          <p>Platform Fee: ₹ 20</p>
          <p>Delivery Fee: ₹ 0</p>
        </div>

        <!-- Add to Cart -->
        <a
          href="/cart/add/<%= product._id %>"
          class="mt-auto text-center border border-blue-500 text-blue-500 py-2 text-sm uppercase tracking-wide
                 hover:bg-blue-500 hover:text-black transition"
        >
          Add to Cart
        </a>

      </div>


  </div>

</main>

</body>
</html>
