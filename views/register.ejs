<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Register</title>
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body class="bg-black text-gray-200">

<!-- Container -->
<div class="min-h-screen flex items-center justify-center px-6">

  <div class="w-full max-w-md border border-gray-800 p-8">
    
    <h1 class="text-2xl font-semibold text-white mb-2">
      Create Account
    </h1>
    <p class="text-gray-400 text-sm mb-8">
      Register to access the platform
    </p>

    <form method="post" action="/register" class="space-y-5">

      <input
        class="w-full bg-black border border-gray-800 px-4 py-3 text-sm outline-none focus:border-blue-500"
        type="text"
        placeholder="Username"
        name="username"
      />

      <input
        class="w-full bg-black border border-gray-800 px-4 py-3 text-sm outline-none focus:border-blue-500"
        type="email"
        placeholder="Email address"
        name="email"
      />

      <input
        class="w-full bg-black border border-gray-800 px-4 py-3 text-sm outline-none focus:border-blue-500"
        type="password"
        placeholder="Password"
        name="password"
      />

      <input
        class="w-full border border-blue-500 text-blue-500 py-3 text-sm uppercase tracking-wide hover:bg-blue-500 hover:text-black transition cursor-pointer"
        type="submit"
        value="Register"
      />

    </form>

  </div>

</div>

</body>
</html>
