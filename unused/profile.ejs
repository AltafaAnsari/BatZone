<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Document</title>
   <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

</head>
<body>
  <div class="w-full min-h-screen bg-zinc-900 text-white p-10">

    <div class="w-full flex justify-end">
       <a class="bg-red-500 rounded-md px-3 py-2 text-sm mb-5 inline-block" href="/logout">Logout</a>
    </div>
   
       <h3 class="text-3xl mb-3"><span class="font-light">Hello</span>! <%= user.username %>👋</h3>
       <h3>Now, you can access all our services.</h3>
       <a class="bg-blue-500 rounded-md px-3 py-2 text-sm mt-5 inline-block" href="/afterlogin">Back To Home</a>

    </div>
  
</body>
</html>